# Maven
**/target/
*.class
*.jar
*.war

# 运行日志
logs/
*.log
derby.*

# Node
*/node_modules/
dist/
.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Build
.gradle/
build/
node_modules

# 数据库备份：**人工编写的迁移/回滚/校验脚本是"数据自洽"的证据链，必须入库**。
# 之前整目录被忽略，导致 consistency_fix1..11 + verify_*.py 只存在于本机磁盘上。
# 只排除临时草稿（_ 前缀）与 py 缓存。
/db_backups/*
!/db_backups/*.sql
!/db_backups/*.py
!/db_backups/*.sh
!/db_backups/*.md
/db_backups/_*
/db_backups/__pycache__/

# 本地工具缓存 / 误解压产物 / 散图
.codebuddy/
BOOT-INF/
temp_gateway/
generated-images/

# 一次性草稿（接口转储、临时修复脚本）
# 约定：`_*.txt` 一律是扫描/探针草稿，不入库 —— 仓库根和 academic-microservices/ 下都算。
# （原规则只写了 academic-microservices/ 一层，2026-10-01 在仓库根写草稿时漏网了。）
/tmp/
_*.txt
academic-microservices/_*.txt

# testsprite：脚本与 plan 入库，跑出来的产物不入库
# （.txt 产物可能比源码旧 —— 见 memory，报红先核对源码）
testsprite/local-check/*.txt
testsprite/local-check/*.png
testsprite/local-check/*.prev

# Claude Code：project skill / 命令 / 项目配置入库（.claude/skills/** 是这台机器上
# 跑通的流程，值得跟着仓库走）；只有 settings.local.json 是个人本地覆盖，不入库。
.claude/settings.local.json

# 运行时产物目录（`export.dir` 默认 ./exports）：管理员导出 Excel、以及
# 2026-10-02 起 mysqldump 生成的真备份 .sql 都落在这里。它们**不是**交付物 ——
# 备份是"这台机器上当前那一刻的数据快照"，入库只会让仓库里躺着一份会和活库漂移的副本。
/academic-microservices/*/exports/
# ⚠️ 2026-10-04 补：上面那条少了一层 —— 备份落的是 `academic-microservices/exports/backups/`
# （服务**外**，不是每个服务各自一份），`*/exports/` 匹配不到它，于是两份 566KB 的全库 dump
# 一直以未跟踪状态躺在工作区里（内含 `users` 的密码哈希）。
/academic-microservices/exports/

# 写库探针跑之前拍的整库快照（同上一族：内含密码哈希，不该入库）。
# 之所以要点名，是因为下面 `!/db_backups/*.sql` 把 .sql 白名单放开了 ——
# 一次 `git add -A` 就会把它带进去。
/db_backups/prerun_*_*.sql
