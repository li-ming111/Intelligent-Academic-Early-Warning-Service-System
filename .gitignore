# Maven
**/target/
*.class
*.jar
*.war

# 运行日志
logs/
*.log
derby.*

# Node
*/node_modules/
dist/
.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Build
.gradle/
build/
node_modules

# 数据库备份：**人工编写的迁移/回滚/校验脚本是"数据自洽"的证据链，必须入库**。
# 之前整目录被忽略，导致 consistency_fix1..11 + verify_*.py 只存在于本机磁盘上。
# 只排除临时草稿（_ 前缀）与 py 缓存。
/db_backups/*
!/db_backups/*.sql
!/db_backups/*.py
!/db_backups/*.sh
!/db_backups/*.md
/db_backups/_*
/db_backups/__pycache__/

# 本地工具缓存 / 误解压产物 / 散图
.codebuddy/
BOOT-INF/
temp_gateway/
generated-images/

# 一次性草稿（接口转储、临时修复脚本）
# 约定：`_*.txt` 一律是扫描/探针草稿，不入库 —— 仓库根和 academic-microservices/ 下都算。
# （原规则只写了 academic-microservices/ 一层，2026-10-01 在仓库根写草稿时漏网了。）
/tmp/
_*.txt
academic-microservices/_*.txt

# testsprite：脚本与 plan 入库，跑出来的产物不入库
# （.txt 产物可能比源码旧 —— 见 memory，报红先核对源码）
testsprite/local-check/*.txt
testsprite/local-check/*.png
testsprite/local-check/*.prev

# Claude Code：project skill / 命令 / 项目配置入库（.claude/skills/** 是这台机器上
# 跑通的流程，值得跟着仓库走）；只有 settings.local.json 是个人本地覆盖，不入库。
.claude/settings.local.json

# 第三方 skill 的**安装产物**不入库（2026-10-14）。`npx skills add <owner>/<repo>` 会把
# 同一份内容铺到多个 agent 目录：真身落 `.agents/skills/`，`.claude|.codebuddy|.qoder/skills/`
# 下再挂**符号链接**。
# ⚠️ 本机 `core.symlinks=false` ⇒ git 不认这些链接，`git add` 会把它们当**普通文件**
#    提交一整份副本（`.agents/` 7.2MB，darwin-skill 单条就 5.2MB；且每条 skill 自带
#    14 个 png/gif 文档图）—— 上游一更新就整目录翻一遍。
# ⇒ 复现性交给仓库根的 `skills-lock.json`（记 source + skillPath + sha256，**这一份要入库**），
#    内容本身按需 `npx skills add` 复原。
# 注意 `.agents/skills/testsprite-onboard|verify` 虽在同一目录，但它们是**本仓自己**写的、
# 早已随 `.claude/skills/` 入库（实体目录，不是链接）——所以这条只点第三方那 5 条，
# 不整目录忽略，免得把本仓自己的 skill 一起挡在门外。
# ⚠️ 2026-10-14 复核：`.agents/skills/testsprite-onboard|verify` 是那两条的**逐字节副本**
#    （`diff -rq` 无输出，30335 字节一致），规范位置已入库 ⇒ 整个 `.agents/` 都是可复原的
#    安装产物，整目录忽略。本仓自写的 skill 规范位置一律是 `.claude/skills/`（**入库**）。
.agents/
.claude/skills/darwin-skill
.claude/skills/finesse-ui
.claude/skills/finesse-brief
.claude/skills/frame-smith
.claude/skills/finesse-term
.qoder/skills/
.codebuddy/skills/

# 运行时产物目录（`export.dir` 默认 ./exports）：管理员导出 Excel、以及
# 2026-10-02 起 mysqldump 生成的真备份 .sql 都落在这里。它们**不是**交付物 ——
# 备份是"这台机器上当前那一刻的数据快照"，入库只会让仓库里躺着一份会和活库漂移的副本。
/academic-microservices/*/exports/
# ⚠️ 2026-10-04 补：上面那条少了一层 —— 备份落的是 `academic-microservices/exports/backups/`
# （服务**外**，不是每个服务各自一份），`*/exports/` 匹配不到它，于是两份 566KB 的全库 dump
# 一直以未跟踪状态躺在工作区里（内含 `users` 的密码哈希）。
/academic-microservices/exports/

# 写库探针跑之前拍的整库快照（同上一族：内含密码哈希，不该入库）。
# 之所以要点名，是因为下面 `!/db_backups/*.sql` 把 .sql 白名单放开了 ——
# 一次 `git add -A` 就会把它带进去。
/db_backups/prerun_*_*.sql

# 仓库根的 ./exports —— 服务配置 `export.dir` 的默认落点，运行期生成的管理员导出
# Excel。上面只忽略了 `academic-microservices/{exports,*/exports/}` 两种，漏了根目录这一份，
# 于是 `exports/成绩导入模板.xlsx` 一直以未跟踪状态挂在 `git status` 里。
/exports/

# testsprite 探针的**一次性产物**：
# `*.bak` = 变异测试前对被测源码拍的备份（内容是已入库源码的副本，跑完即弃）；
# `*.xlsx` = W19 成绩导入探针现造的 Excel 夹具（探针每次自己重建）。
# 与上面 `*.txt/*.png/*.prev` 同族：脚本入库、产物不入库。
testsprite/local-check/*.bak
testsprite/local-check/*.xlsx
